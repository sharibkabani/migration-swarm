# Copy to .env. Never commit .env.

# Billed backend (llm_backend: api, the default)
ANTHROPIC_API_KEY=
# Separate, spend-limited key for the Claude Code baselines (untrusted test code in their container can read it)
MSW_BASELINE_ANTHROPIC_API_KEY=

# Claude plan backend (--backend plan): not billed, draws from your plan's usage limits.
# The swarm uses your host Claude Code login. The Claude Code baselines need a token from
# `claude setup-token` (revocable; untrusted test code in their container can read it).
CLAUDE_CODE_OAUTH_TOKEN=
